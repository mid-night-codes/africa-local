{
  "name": "africa-local",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first emulator platform for African digital services",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "africa-local": "./cli/bin/africa-local.js"
  },
  "scripts": {
    "setup": "npm install",
    "prepare": "husky",
    "check-commits": "node scripts/require-issue-reference.js",
    "start": "node runtime/index.js",
    "validate:schemas": "node scripts/validate-schemas.js",
    "validate:providers": "node scripts/validate-providers.js",
    "validate:registry": "node scripts/validate-registry.js",
    "validate": "npm run validate:schemas && npm run validate:providers && npm run validate:registry",
    "check-contracts": "node scripts/validate-contracts.js",
    "lint": "node scripts/lint-repo.js",
    "test": "node --test $(find core runtime cli scripts -name '*.test.js')",
    "test:conformance": "node --test $(find conformance -name '*.test.js')"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^12.1.0",
    "express": "^4.21.2",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7"
  }
}
