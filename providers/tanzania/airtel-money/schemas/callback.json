{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Airtel Money TZ - Payment Callback",
  "description": "Shape of the payload POSTed to callbackUrl. Delivery metadata (signature, event id, attempt) travels as headers - see core/callbacks/README.md.",
  "type": "object",
  "additionalProperties": true,
  "required": ["transactionId", "status", "responseCode", "responseMessage"],
  "properties": {
    "transactionId": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["SUCCESS", "FAILED", "CANCELLED", "EXPIRED"]
    },
    "responseCode": { "type": "string" },
    "responseMessage": { "type": "string" }
  }
}
